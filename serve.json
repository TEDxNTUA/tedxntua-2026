{
  "trailingSlash": true,
  "headers": [
    {
      "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|avif|mp4|webm|otf|ttf|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/tedxntua-2026/:path*", "destination": "/:path*" }
  ]
}
